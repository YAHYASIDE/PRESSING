rules_version = '2';

// Simple single-owner app.
// The whole app state lives in ONE document: appState/main. The app reads and
// writes it directly from the browser, with no login screen — exactly like the
// original version.
//
// SECURITY NOTE: this document is open to anyone who knows the project ID
// (which is embedded in index.html and therefore public). Everything else in
// the database is denied, so the exposure is limited to this one document.
// To lock it down, enable Email/Password auth, add a sign-in to the app, and
// change the rule below to:  allow read, write: if request.auth != null;
service cloud.firestore {
  match /databases/{database}/documents {

    match /appState/main {
      allow read, write: if true;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
